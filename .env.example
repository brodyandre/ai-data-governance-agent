# AI Data Governance Agent — local non-secret configuration
#
# Copy this file to .env only if your local workflow needs explicit values.
# Never place credentials, API keys, tokens, passwords or private keys here.

# Base URL used by the Node.js web interface to call the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000

# Port used by the Node.js web interface.
PORT=3000

# The current MVP does not require provider credentials.
# Future provider integrations must keep secrets outside version control.
