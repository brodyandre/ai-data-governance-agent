<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>AI Data Governance Agent</title>
    <link
      rel="stylesheet"
      href="/css/main.css"
    />
  </head>

  <body>
    <main
      class="container"
      data-api-base-url="<%= apiBaseUrl %>"
    >
      <header class="page-header">
        <div>
          <p class="eyebrow">
            Governança de Dados + IA
          </p>

          <h1>AI Data Governance Agent</h1>

          <p class="page-description">
            Registre um incidente de dados e envie
            as evidências disponíveis para análise
            estruturada.
          </p>
        </div>

        <div class="backend-status">
          <span>API de análise</span>
          <code><%= apiBaseUrl %></code>
        </div>
      </header>

      <section class="panel">
        <div class="panel-header">
          <div>
            <p class="section-label">
              Registro de incidente
            </p>

            <h2>Novo incidente</h2>
          </div>

          <div class="demo-actions">
            <button
              id="load-demo"
              class="button secondary"
              type="button"
            >
              Carregar cenário DE-101
            </button>

            <button
              id="load-demo-de102"
              class="button secondary"
              type="button"
            >
              Carregar cenário DE-102
            </button>
          </div>
        </div>

        <form id="incident-form">
          <div class="form-grid">
            <label>
              ID do incidente
              <input
                id="incident-id"
                name="incident_id"
                type="text"
                placeholder="INC-001"
                required
              />
            </label>

            <label>
              Sistema de origem
              <input
                id="source-system"
                name="source_system"
                type="text"
                placeholder="orders-lakehouse"
                required
              />
            </label>

            <label class="full-width">
              Título
              <input
                id="incident-title"
                name="title"
                type="text"
                placeholder="Descreva o incidente em uma frase"
                required
              />
            </label>

            <label class="full-width">
              Descrição
              <textarea
                id="incident-description"
                name="description"
                rows="4"
                placeholder="Contexto técnico do incidente"
                required
              ></textarea>
            </label>

            <label>
              Detectado em
              <input
                id="detected-at"
                name="detected_at"
                type="datetime-local"
                required
              />
            </label>

            <label>
              Severidade inicial
              <select
                id="initial-severity"
                name="initial_severity"
              >
                <option value="">
                  Não informada
                </option>
                <option value="low">
                  Baixa
                </option>
                <option value="medium">
                  Média
                </option>
                <option value="high">
                  Alta
                </option>
                <option value="critical">
                  Crítica
                </option>
              </select>
            </label>

            <label class="full-width">
              Datasets afetados
              <input
                id="affected-datasets"
                name="affected_datasets"
                type="text"
                placeholder="orders, order_items, fct_sales"
              />
              <small>
                Separe vários datasets por vírgula.
              </small>
            </label>

            <label class="full-width">
              Contexto de negócio
              <textarea
                id="business-context"
                name="business_context"
                rows="3"
                placeholder="Explique por que esse dado é relevante para o negócio"
              ></textarea>
            </label>

            <label class="full-width">
              Evidências
              <textarea
                id="incident-evidence"
                name="evidence"
                rows="14"
                spellcheck="false"
                required
              >[]</textarea>
              <small>
                Informe um array JSON de evidências.
              </small>
            </label>

            <label class="full-width">
              Tags
              <input
                id="incident-tags"
                name="tags"
                type="text"
                placeholder="data-quality, reconciliation"
              />
              <small>
                Separe várias tags por vírgula.
              </small>
            </label>
          </div>

          <div
            id="form-message"
            class="form-message"
            role="status"
            aria-live="polite"
          ></div>

          <div class="form-actions">
            <button
              id="reset-form"
              class="button secondary"
              type="reset"
            >
              Limpar
            </button>

            <button
              id="submit-button"
              class="button primary"
              type="submit"
            >
              Enviar para análise
            </button>
          </div>
        </form>

        <p class="scope-note">
          O incidente é enviado para análise e o resultado estruturado é apresentado abaixo.
        </p>
      </section>
      <section
        id="analysis-result"
        class="result-section"
        aria-live="polite"
        hidden
      >
        <div class="result-section-header">
          <div>
            <p class="section-label">Resultado da análise</p>
            <h2>Resultado da análise</h2>
          </div>
        </div>

        <div id="analysis-result-content"></div>
      </section>

    </main>

    <script type="module" src="/js/main.js"></script>
  </body>
</html>
