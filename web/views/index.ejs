<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>AI Data Governance Agent</title>
    <link
      rel="stylesheet"
      href="/css/main.css"
    />
  </head>

  <body>
    <main class="container">
      <section class="hero">
        <p class="eyebrow">Data Governance + AI</p>

        <h1>AI Data Governance Agent</h1>

        <p>
          Interface web para análise estruturada
          de incidentes de dados.
        </p>

        <div
          class="status"
          data-api-base-url="<%= apiBaseUrl %>"
        >
          <span>Backend configurado:</span>
          <code><%= apiBaseUrl %></code>
        </div>

        <p class="next-step">
          A entrada e análise de incidentes será
          implementada nas próximas etapas.
        </p>
      </section>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
